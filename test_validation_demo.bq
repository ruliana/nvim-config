-- BigQuery Validation Demo
-- The plugin will show validation results in a floating window at top-right

-- Example 1: Valid query - shows bytes to process
from `bigquery-public-data.samples.wikipedia`
|> where title like 'Google%'
|> select title, id, timestamp
|> limit 100;

-- Example 2: Query with syntax error - shows error message
-- (Uncomment to test - note the typo "likee")
-- from `bigquery-public-data.samples.wikipedia`
-- |> where title likee 'Google%'
-- |> select title, id
-- |> limit 10;

-- Example 3: Another valid query with aggregation
from `bigquery-public-data.samples.wikipedia`
|> aggregate count(*) as total_count
   group_by contributor_username
|> where total_count > 100
|> order_by total_count desc
|> limit 20;

-- HOW TO USE:
-- 1. Place cursor on any query and press <leader>bv to validate
-- 2. Or select multiple lines in visual mode and press <leader>bv
-- 3. Or use :BQValidate command
-- 4. Validation also happens automatically when you pause typing (if buffer modified)
-- 5. The floating window shows:
--    - For valid queries: Bytes to process (formatted as KB/MB/GB)
--    - For invalid queries: Syntax error message with red border